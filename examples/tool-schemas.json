{
  "goalPlan": {
    "type": "function",
    "name": "submit_goal_plan",
    "description": "Submit one current playback goal plan.",
    "parameters": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 64
        },
        "totalMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 960
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 48
              },
              "durationMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "iconId": {
                "type": "string",
                "enum": [
                  "scene-airplane",
                  "scene-banana",
                  "scene-barbecue",
                  "scene-basketball",
                  "scene-beach-umbrella",
                  "scene-beach-wave",
                  "scene-bed",
                  "scene-bicycle",
                  "scene-brain-head",
                  "scene-briefcase",
                  "scene-broom-sparkle",
                  "scene-burger",
                  "scene-cake",
                  "scene-calendar-heart",
                  "scene-campfire",
                  "scene-car",
                  "scene-chat-bubble",
                  "scene-cigarette",
                  "scene-cloud",
                  "scene-cloud-sunrise",
                  "scene-cocktail",
                  "scene-coffee-cup",
                  "scene-cupcake",
                  "scene-dawn",
                  "scene-earbuds",
                  "scene-flip-flops",
                  "scene-handbag",
                  "scene-headphones",
                  "scene-heart-support",
                  "scene-heartbeat",
                  "scene-hearts",
                  "scene-hot-bath",
                  "scene-ice-cream",
                  "scene-island",
                  "scene-laptop",
                  "scene-lightbulb",
                  "scene-lipstick",
                  "scene-moon-night",
                  "scene-mountains-water",
                  "scene-music-note",
                  "scene-noodles",
                  "scene-paintbrush",
                  "scene-palette",
                  "scene-party-popper",
                  "scene-pizza",
                  "scene-potted-plant",
                  "scene-rain-cloud",
                  "scene-rocking-horse",
                  "scene-round-glasses",
                  "scene-rubber-duck",
                  "scene-snowflake",
                  "scene-sofa",
                  "scene-sun",
                  "scene-sunrise",
                  "scene-sunrise-water",
                  "scene-sunset",
                  "scene-swimmer",
                  "scene-swirl",
                  "scene-telescope",
                  "scene-thunder-cloud",
                  "scene-toilet",
                  "scene-ufo",
                  "scene-umbrella",
                  "scene-vinyl-record",
                  "scene-watch",
                  "scene-water-waves",
                  "scene-wave",
                  "scene-wind",
                  "scene-zzz-sleep"
                ]
              }
            },
            "required": [
              "title",
              "durationMinutes",
              "iconId"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "title",
        "totalMinutes",
        "phases"
      ],
      "additionalProperties": false
    }
  },
  "retrieval": [
    {
      "type": "function",
      "name": "same_song_profile_search",
      "description": "Search the current carrier song's complete nine logical Touchpad tracks. Optional profile criteria rank this internal set; no criteria returns current first plus all alternatives. Ordinary songs return their sole unit.",
      "parameters": {
        "type": "object",
        "properties": {
          "nameQuery": {
            "type": "string"
          },
          "tagPreferences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tagId": {
                  "type": "string"
                },
                "importance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "tagId",
                "importance"
              ],
              "additionalProperties": false
            }
          },
          "axisTargets": {
            "type": "object",
            "properties": {
              "arousal": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              },
              "rhythmicDrive": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              },
              "attentionCapture": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              },
              "globalStability": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              },
              "suddenChangeRisk": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              },
              "textureDensity": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              },
              "brightness": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              },
              "warmth": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              },
              "spaciousness": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4
                  }
                },
                "required": [
                  "target",
                  "tolerance"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          }
        },
        "additionalProperties": false
      }
    },
