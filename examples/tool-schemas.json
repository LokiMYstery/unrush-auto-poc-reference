    {
      "type": "function",
      "name": "music_description_recall",
      "description": "Exact donor CLAP description recall. Requires model-authored English queryText; no server rewrite or translation.",
      "parameters": {
        "type": "object",
        "properties": {
          "queryText": {
            "type": "string"
          },
          "textLanguage": {
            "type": "string",
            "enum": [
              "en"
            ]
          },
          "candidateKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "song",
                "touchpad_track"
              ]
            },
            "uniqueItems": true
          },
          "excludePlaybackUnitIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topK": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "queryText",
          "textLanguage"
        ],
        "additionalProperties": false
      }
    }
  ],
  "goalSelection": {
    "type": "function",
    "name": "submit_selection",
    "description": "Submit ordered playbackUnitId choices selected only from retrieval results.",
    "parameters": {
      "type": "object",
      "properties": {
        "playbackUnitIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 5
        },
        "reason": {
          "type": "string",
          "description": "One short user-facing rationale for the FIRST submitted playbackUnitId, comparing it to current/internal options. No private reasoning.",
          "maxLength": 240
        },
        "energyGoal": {
          "type": "string",
          "enum": [
            "boost",
            "lower"
          ],
          "description": "Goal phase energy direction."
        },
        "openingText": {
          "type": "string",
          "description": "Goal phase opening TTS for the selected music. Natural, brief, at most one energy sentence.",
          "maxLength": 120
        },
        "postReceiptText": {
          "type": "string",
          "description": "After-playback explanation for this selected candidate. Short music phrase plus one optional light suggestion. No energy/能量.",
          "maxLength": 120
        }
      },
      "required": [
        "playbackUnitIds",
        "reason",
        "energyGoal",
        "openingText",
        "postReceiptText"
      ],
      "additionalProperties": false
    }
  }
}
